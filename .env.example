# Copy this file to .env and fill it in. .env is ignored by git: never commit it.

# ArborXR: portal > Settings > API tokens.
ABXR_API_TOKEN=

# ManageXR: Organization Settings > API Keys.
MXR_API_KEY_ID=
MXR_API_KEY_SECRET=

# Meta Horizon: developer dashboard > your app > API > App Secret (admin account needed).
# One variable per app: its name is `secret_env` in config.toml.
META_APP_SECRET=

# Full path to ovr-platform-util.exe, from
# https://developers.meta.com/horizon/resources/publish-reference-platform-command-line-utility/
OVR_PLATFORM_UTIL=
